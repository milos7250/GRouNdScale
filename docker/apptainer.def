Bootstrap: docker
From: pytorch/pytorch:2.14.0-cuda13.2-cudnn9-runtime

%environment
    export DEBIAN_FRONTEND=noninteractive
    export PATH="/opt/venv/bin:${PATH}"

%files
    requirements.txt /groundscale/requirements.txt
    requirements2.txt /groundscale/requirements2.txt
    src /groundscale/src
    arboreto.patch /groundscale/arboreto.patch

%post
    set -eu

    # Upgrade system packages and fix the cmake wrapper bug.
    rm -rf /usr/local/bin/cmake
    apt-get update \
        && apt-get upgrade -y --no-install-recommends \
        && apt-get install -y git g++ make cmake python3-venv \
        && apt-get clean \
        && rm -rf /var/lib/apt/lists/*

    # Create working directory
    mkdir -p /groundscale

    # Install dependencies into an isolated environment using the system Python.
    python -m venv --system-site-packages /opt/venv
    export PATH="/opt/venv/bin:${PATH}"
    python -m pip install --upgrade pip setuptools wheel

    # Install dependencies from requirements.txt
    python -m pip install \
        --root-user-action ignore \
        --no-cache-dir \
        -r /groundscale/requirements.txt
    python -m pip install \
        --root-user-action ignore \
        --no-cache-dir \
        --no-build-isolation \
        -r /groundscale/requirements2.txt

    # Cleanup pip cache
    rm -rf /root/.cache/pip || true

    # Patch arboreto bug
    patch -d "$(python -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')/arboreto" < /groundscale/arboreto.patch


%runscript
    # If no args provided, default to --help to match Docker CMD
    if [ "$#" -eq 0 ]; then
      set -- --help
    fi
    exec /opt/venv/bin/python /groundscale/src/main.py "$@"

%help
    Apptainer image for GRouNdScale based on pytorch/pytorch:2.14.0-cuda13.2-cudnn9-runtime.
    Provide arguments to run the main.py script, e.g.:
    `apptainer run groundscale.sif --train --config gan.cfg`

    Defaults to running:
    `/opt/venv/bin/python /groundscale/src/main.py --help`
