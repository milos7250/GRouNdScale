# Copies of the processed data of publication/ (the causal graphs are small and stay tracked)
*.h5ad

# Per-run outputs: keep the measurements, drop everything the training writes
/*/results/*/*/*
!/*/results/*/*/summary.json
!/*/results/*/*/trace.json
!/*/results/*/*/nvidia-smi.csv
!/*/results/*/*/causal_gan.cfg

# Drop the compile overhead results and logs, they are not needed for publication
/compile-overhead/results
/compile-overhead/logs

/*/logs/*
!/*/logs/.gitkeep
__pycache__/

# The inferred GRNs of data/base are copies of publication/size-compare
/*/data/**/*.csv
